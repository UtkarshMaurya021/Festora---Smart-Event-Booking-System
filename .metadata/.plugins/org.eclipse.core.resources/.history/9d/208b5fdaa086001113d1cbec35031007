package com.festora.controller;

import com.festora.entity.Venue;
import com.festora.service.VenueService;
import org.springframework.web.bind.annotation.*;

import java.util.List;

@RestController
@RequestMapping("/api/venues")
@CrossOrigin("*")
public class VenueController {

    private final VenueService service;

    public VenueController(VenueService service) {

        this.service = service;

    }

    @GetMapping
    public List<Venue> getAll() {

        return service.getAll();

    }

    @PostMapping
    public Venue create(@RequestBody Venue venue) {

        return service.create(venue);

    }

    @PutMapping("/{id}")
    public Venue update(@PathVariable Long id,
                        @RequestBody Venue venue) {

        return service.update(id, venue);

    }

    @DeleteMapping("/{id}")
    public void delete(@PathVariable Long id) {

        service.delete(id);

    }

}